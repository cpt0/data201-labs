        "def test_rmse(model):\n",
        "    pipe = Pipeline([('preprocess', make_preprocessor()), ('model', model)])\n",
        "    pipe.fit(X_train, y_train)\n",
        "    return np.sqrt(mean_squared_error(y_test, pipe.predict(X_test)))\n",
        "\n",
        "# Linear regression has no alpha, so it's the same in every graph\n",
        "lin_rmse = test_rmse(LinearRegression())\n",
        "\n",
        "rows = []\n",
        "for a in [0.1, 10, 100]:\n",
        "    rows.append({\n",
        "        'alpha': a,\n",
        "        'Linear Regression': lin_rmse,\n",
        "        'Lasso': test_rmse(Lasso(alpha=a, max_iter=30000)),\n",
        "        'Ridge': test_rmse(Ridge(alpha=a))\n",
        "    })\n",
        "rmse_table = pd.DataFrame(rows)\n",
        "display(rmse_table.round(2))\n",
        "\n",
        "# Three graphs: one per alpha\n",
        "fig, axes = plt.subplots(1, 3, figsize=(15, 4.5), sharey=True)\n",
        "names = ['Linear Regression', 'Lasso', 'Ridge']\n",
        "colors = ['red', 'orange', 'blue']\n",
        "\n",
        "for ax, (_, r) in zip(axes, rmse_table.iterrows()):\n",
        "    vals = [r[n] for n in names]\n",
        "    bars = ax.bar(names, vals, color=colors)\n",
        "    ax.bar_label(bars, fmt='%.2f', padding=3)\n",
        "    ax.set_title(f'Test RMSE at alpha = {r[\"alpha\"]:g}')\n",
        "    ax.set_ylabel('Test RMSE')\n",
        "    ax.grid(axis='y', alpha=0.3)\n",
        "\n",
        "axes[0].set_ylim(rmse_table[names].min().min() - 15,\n",
